{
    "include": [
        "backend"
    ],
    "exclude": [
        "**/node_modules",
        "**/__pycache__",
        "**/.venv"
    ],
    "venvPath": "e:/mr",
    "venv": ".venv",
    "extraPaths": [
        "./",
        "backend"
    ],
    "executionEnvironments": [
        {
            "root": "backend",
            "pythonVersion": "3.14",
            "extraPaths": [
                "backend"
            ]
        }
    ],
    "typeCheckingMode": "basic",
    "useLibraryCodeForTypes": true
}
