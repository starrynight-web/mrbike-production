{
    "include": [
        "backend",
        "frontend"
    ],
    "exclude": [
        "**/node_modules",
        "**/__pycache__",
        "**/.venv",
        "backend/venv"
    ],
    "venvPath": ".",
    "venv": ".venv",
    "extraPaths": [
        "backend"
    ],
    "executionEnvironments": [
        {
            "root": "backend",
            "extraPaths": [
                "."
            ]
        }
    ],
    "typeCheckingMode": "basic",
    "useLibraryCodeForTypes": true
}