# ========================================
# DJANGO SETTINGS
# ========================================
DEBUG=True
SECRET_KEY=django-insecure-mrbikebd-development-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,*.vercel.app

# ========================================
# DATABASE - SUPABASE POSTGRESQL
# ========================================
# Supabase PostgreSQL URL (primary database for relational data)
DATABASE_URL=postgresql://postgres:password@localhost:5432/mrbikebd

# Alternative: Use Supabase
# DATABASE_URL=postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require

# ========================================
# MONGODB ATLAS (Flexible data storage)
# ========================================
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/mrbikebd
MONGODB_DB_NAME=mrbikebd

# ========================================
# REDIS CACHE
# ========================================
REDIS_URL=redis://localhost:6379/1
REDIS_SSL=false

# ========================================
# CLOUDINARY (Image CDN)
# ========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ========================================
# FRONTEND URL (for links)
# ========================================
FRONTEND_URL=http://localhost:3000

# ========================================
# GOOGLE OAUTH
# ========================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ========================================
# EMAIL CONFIGURATION (Brevo/Sendinblue)
# ========================================
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
BREVO_SMTP_USER=your_brevo_email
BREVO_API_KEY=your_brevo_api_key
DEFAULT_FROM_EMAIL=noreply@mrbikebd.com

# ========================================
# CORS SETTINGS
# ========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# ========================================
# SENTRY (Error tracking)
# ========================================
SENTRY_DSN=https://your_sentry_key@sentry.io/your_project_id

# ========================================
# DEVELOPMENT
# ========================================
DEBUG_OTP=True
